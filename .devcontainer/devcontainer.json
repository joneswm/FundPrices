{
	"name": "FundPrices - Python",
	// Use Python-specific image for faster startup and smaller size
	"image": "mcr.microsoft.com/devcontainers/python:3.12",

	// Install Python dependencies on container creation
	"postCreateCommand": "pip install -r requirements.txt && playwright install --with-deps chromium",

	// VS Code extensions for Python development
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.debugpy",
				"ms-python.black-formatter",
				"ms-python.isort",
				"ms-python.flake8"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.testing.unittestEnabled": true,
				"python.testing.unittestArgs": [
					"-v",
					"-s",
					".",
					"-p",
					"test_*.py"
				],
				"[python]": {
					"editor.defaultFormatter": "ms-python.black-formatter",
					"editor.formatOnSave": true
				},
				"black-formatter.args": ["--line-length=88"],
				"isort.args": ["--profile=black", "--line-length=88"],
				"flake8.args": ["--max-line-length=88", "--ignore=E203,W503"]
			}
		}
	},

	// Forward ports for any future web interfaces
	"forwardPorts": [],

	// Set environment variables
	"remoteEnv": {
		"PYTHONUNBUFFERED": "1"
	}
}
